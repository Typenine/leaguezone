{
  "name": "leaguezone-hq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/migrate-on-build.mjs; next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "migrate:blob-to-db": "tsx scripts/migrate-blob-to-db.ts",
    "migrate:blob-media-to-r2": "tsx scripts/migrate-blob-media-to-r2.ts",
    "cleanup:blob": "tsx scripts/cleanup-blob.ts",
    "setup:all": "npm run db:generate && npm run db:migrate && npm run db:seed && npm run migrate:blob-to-db -- --write && npm run migrate:blob-media-to-r2 -- --write && npm run cleanup:blob -- --confirm",
    "verify:r2": "node scripts/verify-r2.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.651.1",
    "@aws-sdk/s3-request-presigner": "^3.651.1",
    "@google/generative-ai": "^0.24.1",
    "@headlessui/react": "^2.2.7",
    "@heroicons/react": "^2.2.0",
    "@neondatabase/serverless": "^0.10.3",
    "@tiptap/extension-image": "^3.26.0",
    "@tiptap/extension-link": "^3.26.0",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/kv": "^1.0.1",
    "@xyflow/react": "12.8.3",
    "bcryptjs": "^3.0.3",
    "classnames": "2.5.1",
    "d3-dag": "1.1.0",
    "drizzle-orm": "0.36.0",
    "elkjs": "0.10.0",
    "fast-xml-parser": "^4.4.1",
    "gsap": "^3.12.5",
    "html-to-image": "1.11.13",
    "isomorphic-dompurify": "^3.16.0",
    "jspdf": "3.0.1",
    "lucide-react": "^1.14.0",
    "mammoth": "^1.12.0",
    "next": "15.4.10",
    "pg": "^8.16.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.12.4",
    "svg2pdf.js": "2.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.4.5",
    "drizzle-kit": "0.26.0",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "use-sync-external-store": "1.5.0"
  }
}
